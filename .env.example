# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_LEADS_WEBHOOK_URL: Google Apps Script Web App URL for storing lead form submissions in Google Sheets
VITE_LEADS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEB_APP_ID/exec"

# Optional Firebase Firestore Configuration (Backup Lead Storage)
VITE_USE_FIREBASE_LEADS="false"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

